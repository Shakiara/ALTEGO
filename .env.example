# ALTEGO necesita una plantilla segura para configurar cada instalación local.
# Este archivo declara las variables de conexión y rutas sin incluir credenciales privadas.
PORT=3000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_local_password
MYSQL_DATABASE=tienda_avatares_2053
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=tienda_avatares_2053


ALTEGO_STORAGE_ROOT=

FRONTEND_ORIGIN=http://localhost:4200
WEB_PORT=4200
