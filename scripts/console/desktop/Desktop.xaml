<!-- ALTEGO necesita una consola gráfica organizada para su instalación y supervisión en Windows. -->
<!-- Esta vista WPF distribuye controles de servidores, registros, rutas y configuración. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ALTEGO Dev Console" Width="1180" Height="800" MinWidth="840" MinHeight="580" WindowStartupLocation="CenterScreen" Background="#10141E" Foreground="#E8ECF5" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
<Style TargetType="PasswordBox"><Setter Property="Background" Value="#1C2333"/><Setter Property="Foreground" Value="#E8ECF5"/><Setter Property="BorderBrush" Value="#3D4659"/><Setter Property="Padding" Value="9,7"/></Style>

  <Style TargetType="Button"><Setter Property="Foreground" Value="#E5EAF4"/><Setter Property="Background" Value="#262D3E"/><Setter Property="BorderBrush" Value="#3A4359"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4,0,0,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#35405A"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#B4A6E7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#1A2130"/><Setter Property="Foreground" Value="#EDF0F7"/><Setter Property="BorderBrush" Value="#353F53"/><Setter Property="Padding" Value="9,7"/><Setter Property="CaretBrush" Value="#D1C7FF"/><Setter Property="SelectionBrush" Value="#655C8C"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#D3DCEC"/><Setter Property="Foreground" Value="#182131"/><Setter Property="Padding" Value="7,6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#D5DEEC"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="#191F2C"/><Setter Property="BorderBrush" Value="#2C3548"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/></Style>
  <DataTemplate x:Key="LogTemplate"><Border BorderBrush="#273044" BorderThickness="0,0,0,1" Padding="10,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding time}" Foreground="#8897B0" FontSize="11" Margin="0,3,8,0"/><StackPanel Grid.Column="1"><StackPanel Orientation="Horizontal" Margin="0,0,0,4"><TextBlock Text="{Binding source}" Foreground="#BDB2E6" FontWeight="SemiBold"/><TextBlock Text="{Binding level}" Foreground="{Binding color}" Margin="12,0,0,0" FontSize="11"/></StackPanel><TextBlock Text="{Binding message}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" LineHeight="18"/></StackPanel></Grid></Border></DataTemplate>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#151A26" BorderBrush="#2A3245" BorderThickness="0,0,1,0"><DockPanel Margin="14,24,14,18"><StackPanel DockPanel.Dock="Top" Margin="12,0,0,32"><TextBlock Text="ALTEGO" FontSize="23" FontWeight="SemiBold" Foreground="#C9BAF2"/><TextBlock Text="DEVELOPMENT" FontSize="10" Foreground="#7E8AA3" Margin="1,5,0,0"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Margin="12,20,0,0"><TextBlock Text="LOCAL SESSION" FontSize="10" Foreground="#6F7D97"/><TextBlock x:Name="Connection" Text="Connecting…" Foreground="#F0CE8A" Margin="0,5,0,0"/><TextBlock Text="Terminal logs stay available" FontSize="10" Foreground="#8591A8" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
   <ListBox x:Name="Navigation" SelectedIndex="0" VerticalAlignment="Top" AutomationProperties.Name="Console sections"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,12"/><Setter Property="Margin" Value="0,3"/><Setter Property="Foreground" Value="#A7B4CB"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="NavBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#302B46"/><Setter Property="Foreground" Value="#D4C6FF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="BorderBrush" Value="#75678E"/><Setter TargetName="NavBorder" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBoxItem Content="Overview"/><ListBoxItem Content="API Server"/><ListBoxItem Content="Frontend"/><ListBoxItem Content="Databases"/><ListBoxItem Content="All Logs"/><ListBoxItem Content="Route Explorer"/><ListBoxItem Content="Setup &amp; Installation"/></ListBox>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="26,22,26,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Overview" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="SessionState" Text="Starting development session…" Foreground="#929FB8" Margin="0,5,0,0"/></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="Start" Content="Start Servers" AutomationProperties.Name="Start Servers"/><Button x:Name="Stop" Content="Stop Servers" AutomationProperties.Name="Stop Servers"/><Button x:Name="Restart" Content="Restart Servers" AutomationProperties.Name="Restart Servers"/></WrapPanel></Grid>
   <Border x:Name="ServiceInfoPanel" Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,16" Visibility="Collapsed"><StackPanel><TextBlock x:Name="ServiceInfo" TextWrapping="Wrap" FontSize="14"/><TextBlock x:Name="ServiceNote" TextWrapping="Wrap" Foreground="#929FB8" Margin="0,7,0,0"/></StackPanel></Border>
   <Grid x:Name="Overview" Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <ItemsControl x:Name="Services"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Panel}" Margin="0,0,12,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding name}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding address}" Foreground="#95A4BC" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding extra}" Foreground="#7E8CA6" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding status}" Foreground="{Binding color}" Margin="10,1,0,0" FontWeight="SemiBold"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,12,12" Padding="16,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FRONTEND BUILD" Foreground="#8390AA" FontSize="10"/><TextBlock x:Name="Build" Text="Waiting" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="WATCH MODE" Foreground="#8390AA" FontSize="10"/><TextBlock x:Name="Watch" Text="Waiting for Angular" Margin="0,5,0,0"/></StackPanel></Grid></Border>
    <Border x:Name="AlertPanel" Grid.Row="2" Style="{StaticResource Panel}" BorderBrush="#6F4C52" Background="#2A202A" Margin="0,0,12,12" Visibility="Collapsed" Padding="14,10"><ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Alert" Foreground="#E5B4BD" TextWrapping="Wrap"/></ScrollViewer></Border>
    <Border Grid.Row="3" Style="{StaticResource Panel}" Margin="0,0,12,0" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Recent activity" FontWeight="SemiBold" Margin="8,4,0,10"/><ListBox x:Name="Recent" ItemTemplate="{StaticResource LogTemplate}"/></DockPanel></Border>
   </Grid>
   <Grid x:Name="LogsPanel" Grid.Row="2" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,12"><StackPanel Margin="0,0,10,8"><TextBlock Text="Source" Foreground="#929FB8" FontSize="11" Margin="0,0,0,5"/><ComboBox x:Name="Source" Width="125" AutomationProperties.Name="Filter by source"><ComboBoxItem Content="All"/><ComboBoxItem Content="API"/><ComboBoxItem Content="Frontend"/><ComboBoxItem Content="Databases"/><ComboBoxItem Content="Console"/></ComboBox></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Level" Foreground="#929FB8" FontSize="11" Margin="0,0,0,5"/><ComboBox x:Name="Level" Width="115" AutomationProperties.Name="Filter by level"><ComboBoxItem Content="All"/><ComboBoxItem Content="Info"/><ComboBoxItem Content="Success"/><ComboBoxItem Content="Warning"/><ComboBoxItem Content="Error"/></ComboBox></StackPanel><StackPanel Margin="0,0,10,8"><TextBlock Text="Search" Foreground="#929FB8" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="Search" Width="195" AutomationProperties.Name="Search logs"/></StackPanel><Button x:Name="Pause" Content="Pause" VerticalAlignment="Bottom" Margin="0,0,10,8"/><CheckBox x:Name="Autoscroll" Content="Autoscroll" IsChecked="True" Foreground="#BAC5D8" VerticalAlignment="Bottom" Margin="0,0,0,17"/></WrapPanel>
    <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="4"><Grid><ListBox x:Name="Logs" ItemTemplate="{StaticResource LogTemplate}"/><TextBlock x:Name="Empty" Text="No matching logs" Foreground="#7F8DA7" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/></Grid></Border>
   </Grid>
   <Grid x:Name="RoutesPanel" Grid.Row="2" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,12"><TextBox x:Name="RouteSearch" Width="230" Margin="0,0,10,6" AutomationProperties.Name="Search routes" ToolTip="Search route or restriction"/><ComboBox x:Name="RouteType" Width="115" Margin="0,0,10,6" AutomationProperties.Name="Route type"><ComboBoxItem Content="All"/><ComboBoxItem Content="Frontend"/><ComboBoxItem Content="API"/></ComboBox><ComboBox x:Name="RouteMethod" Width="100" Margin="0,0,10,6" AutomationProperties.Name="HTTP method"><ComboBoxItem Content="All"/><ComboBoxItem Content="PAGE"/><ComboBoxItem Content="GET"/><ComboBoxItem Content="POST"/><ComboBoxItem Content="PUT"/><ComboBoxItem Content="PATCH"/><ComboBoxItem Content="DELETE"/><ComboBoxItem Content="HEAD"/><ComboBoxItem Content="OPTIONS"/></ComboBox><Button x:Name="RefreshRoutes" Content="Refresh inventory" Margin="0,0,0,6"/></WrapPanel>
    <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="4"><ListBox x:Name="RouteList" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Real application routes"><ListBox.ItemTemplate><DataTemplate><Border Padding="12,9" BorderBrush="#30394D" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding label}" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Foreground="#D8CDEE"/><TextBlock Text="{Binding restrictions}" Foreground="#9BA9BE" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
    <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,12,0,0" Padding="14"><StackPanel><TextBlock x:Name="RouteMessage" Text="Loading route inventory…" Foreground="#AAB7CE" TextWrapping="Wrap"/><WrapPanel x:Name="RouteParameters" Margin="0,8,0,0"/><Button x:Name="OpenRoute" Content="Open in browser" HorizontalAlignment="Left" Margin="0,8,0,0" IsEnabled="False"/></StackPanel></Border>
   </Grid>
   <ScrollViewer x:Name="SetupPanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <TextBlock x:Name="SetupMessage" Foreground="#B8C6DE" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <ItemsControl x:Name="SetupSteps"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Panel}" Padding="14,10" Margin="0,0,0,8"><StackPanel><DockPanel><TextBlock Text="{Binding status}" DockPanel.Dock="Right" Foreground="#CDBBE7"/><TextBlock Text="{Binding title}" FontWeight="SemiBold" FontSize="14"/></DockPanel><TextBlock Text="{Binding detail}" TextWrapping="Wrap" Foreground="#97A8C3" Margin="0,5,0,0" FontSize="12"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <WrapPanel Margin="0,4,0,12"><Button x:Name="CheckRequirements" Content="Check Requirements" Margin="0,0,8,8"/><Button x:Name="InstallDependencies" Content="Install Dependencies" Margin="0,0,8,8"/><Button x:Name="ConfigureEnvironment" Content="Configure Environment" Margin="0,0,8,8"/><Button x:Name="InitializeDatabases" Content="Initialize Databases" Margin="0,0,8,8"/><Button x:Name="VerifyInstallation" Content="Verify Installation" Margin="0,0,8,8"/></WrapPanel>
    <Expander x:Name="EnvironmentForm" Header="Local configuration" Foreground="#CFBEDF" Margin="0,0,0,16"><Border Style="{StaticResource Panel}" Margin="0,10,0,0"><StackPanel><TextBlock Text="Existing configuration is preserved as a backup after explicit confirmation. Leave secret fields empty to keep configured values." TextWrapping="Wrap" Foreground="#9BA9BE" Margin="0,0,0,12"/>
    <WrapPanel>
<StackPanel Width="235" Margin="0,0,12,12"><TextBlock Text="MySQL host" Foreground="#9BA9BE" Margin="0,0,0,5"/><TextBox x:Name="Env_mysqlHost" AutomationProperties.Name="MySQL host"/></StackPanel>
<StackPanel Width="235" Margin="0,0,12,12"><TextBlock Text="MySQL port" Foreground="#9BA9BE" Margin="0,0,0,5"/><TextBox x:Name="Env_mysqlPort" AutomationProperties.Name="MySQL port"/></StackPanel>
<StackPanel Width="235" Margin="0,0,12,12"><TextBlock Text="MySQL user" Foreground="#9BA9BE" Margin="0,0,0,5"/><TextBox x:Name="Env_mysqlUser" AutomationProperties.Name="MySQL user"/></StackPanel>
<StackPanel Width="235" Margin="0,0,12,12"><TextBlock Text="MySQL password" Foreground="#9BA9BE" Margin="0,0,0,5"/><PasswordBox x:Name="Env_mysqlPassword" AutomationProperties.Name="MySQL password"/></StackPanel>
<StackPanel Width="235" Margin="0,0,12,12"><TextBlock Text="MySQL database" Foreground="#9BA9BE" Margin="0,0,0,5"/><TextBox x:Name="Env_mysqlDatabase" AutomationProperties.Name="MySQL database"/></StackPanel>
<StackPanel Width="235" Margin="0,0,12,12"><TextBlock Text="MongoDB database" Foreground="#9BA9BE" Margin="0,0,0,5"/><TextBox x:Name="Env_mongoDatabase" AutomationProperties.Name="MongoDB database"/></StackPanel>
<StackPanel Width="235" Margin="0,0,12,12"><TextBlock Text="MongoDB connection URI (private)" Foreground="#9BA9BE" Margin="0,0,0,5"/><PasswordBox x:Name="Env_mongoUri" AutomationProperties.Name="MongoDB connection URI (private)"/></StackPanel>
<StackPanel Width="235" Margin="0,0,12,12"><TextBlock Text="Storage directory" Foreground="#9BA9BE" Margin="0,0,0,5"/><TextBox x:Name="Env_storage" AutomationProperties.Name="Storage directory"/></StackPanel>
<StackPanel Width="235" Margin="0,0,12,12"><TextBlock Text="Express port" Foreground="#9BA9BE" Margin="0,0,0,5"/><TextBox x:Name="Env_apiPort" AutomationProperties.Name="Express port"/></StackPanel>
<StackPanel Width="235" Margin="0,0,12,12"><TextBlock Text="Angular port" Foreground="#9BA9BE" Margin="0,0,0,5"/><TextBox x:Name="Env_webPort" AutomationProperties.Name="Angular port"/></StackPanel>
    </WrapPanel><Button x:Name="SaveEnvironment" Content="Save configuration" HorizontalAlignment="Left" Margin="0,5,0,0"/></StackPanel></Border></Expander>
    <Button x:Name="SetupStart" Content="Start ALTEGO" HorizontalAlignment="Left" Margin="0,0,0,12" IsEnabled="False"/>
    <TextBlock Text="System software is never installed automatically. Install a supported Node.js distribution with npm, Windows WPF/.NET Framework, MySQL and MongoDB separately if missing. Existing databases are validated; they are never reset or upgraded by Setup." TextWrapping="Wrap" Foreground="#8D9BB3" FontSize="12"/>
   </StackPanel></ScrollViewer>
   <TextBlock x:Name="Footer" Grid.Row="3" Text="Connecting to the local supervisor…" FontSize="11" Foreground="#7D8AA3" Margin="0,13,0,0" TextWrapping="Wrap"/>
  </Grid>
 </Grid>
</Window>
